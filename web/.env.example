# ==============================================================================
# Print Infinity — Web Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For Vercel Production Deployment:
# Add each variable below in Vercel Project Settings -> Environment Variables.
# Ensure SUPABASE_SERVICE_ROLE_KEY and RAZORPAY_KEY_SECRET are marked as Server-only!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Client & Server)
# ------------------------------------------------------------------------------
# Your Supabase API URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your_supabase_project_id.supabase.co

# Supabase Public Anonymous Key (safe for client-side bundle)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# Supabase Service Role Secret Key (CRITICAL: Server-only! NEVER expose with NEXT_PUBLIC_)
# Used by Next.js backend API routes (/api/print-jobs/create, /api/payment/webhook) to bypass RLS safely
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 2. Razorpay Payment Gateway Configuration
# ------------------------------------------------------------------------------
# Razorpay Key ID (public key used in customer checkout modal)
# Format: rzp_test_... for Sandbox, rzp_live_... for Production
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here

# Razorpay Key Secret (CRITICAL: Server-only! NEVER prefix with NEXT_PUBLIC_)
# Used by backend API routes (/api/payment/create-order) to generate payment orders
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret (CRITICAL: Server-only!)
# Used by /api/payment/webhook to cryptographically verify HMAC SHA256 webhook signatures
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
