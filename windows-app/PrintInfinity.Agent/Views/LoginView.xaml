<UserControl
    x:Class="PrintInfinity.Agent.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PrintInfinity.Agent.ViewModels"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- Subtle Ambient Background -->
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Width="460"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="36">
            
            <StackPanel Spacing="20">
                <!-- Branding Header -->
                <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,8">
                    <Border Background="#EEF2FF" CornerRadius="28" Width="56" Height="56" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE749;" FontSize="28" Foreground="#4F46E5" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Print Infinity Agent" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="Storekeeper Shop PC Portal" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Mode Title & Subtitle -->
                <TextBlock Text="{x:Bind ViewModel.TitleText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />

                <!-- Error / Success InfoBar -->
                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         Severity="Error"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <InfoBar IsOpen="{x:Bind ViewModel.HasSuccess, Mode=OneWay}"
                         Severity="Success"
                         Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}" />

                <!-- Form Fields -->
                <StackPanel Spacing="14">
                    <TextBox Header="Storekeeper Email" 
                             PlaceholderText="shopkeeper@printinfinity.in"
                             Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <PasswordBox x:Name="PasswordInput"
                                 Header="Password" 
                                 PlaceholderText="Enter at least 6 characters"
                                 Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <PasswordBox x:Name="ConfirmPasswordInput"
                                 Header="Confirm Password" 
                                 PlaceholderText="Re-enter password"
                                 Visibility="{x:Bind ViewModel.RegisterFieldsVisibility, Mode=OneWay}"
                                 Password="{x:Bind ViewModel.ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Content="Remember session on this PC (Windows Credential Locker)"
                              IsChecked="{x:Bind ViewModel.RememberMe, Mode=TwoWay}"
                              FontSize="13" />
                </StackPanel>

                <!-- Submit Button -->
                <Button Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Height="44"
                        Command="{x:Bind ViewModel.SubmitCommand}"
                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                    <Grid>
                        <TextBlock Text="{x:Bind ViewModel.SubmitButtonText, Mode=OneWay}" 
                                   FontWeight="SemiBold" 
                                   Visibility="{x:Bind ViewModel.NotBusyVisibility, Mode=OneWay}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" 
                                      Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" 
                                      Width="20" Height="20" />
                    </Grid>
                </Button>

                <!-- Mode Toggle -->
                <Button Style="{ThemeResource HyperlinkButtonStyle}"
                        HorizontalAlignment="Center"
                        Content="{x:Bind ViewModel.ModeToggleText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleModeCommand}" />

                <!-- Footer Security Badge -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,8,0,0">
                    <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Protected by Windows DPAPI &amp; Credential Locker" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
