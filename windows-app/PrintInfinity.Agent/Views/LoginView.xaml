<UserControl
    x:Class="PrintInfinity.Agent.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PrintInfinity.Agent.ViewModels"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Grid Background="#F8FAFC">
        <!-- Soft ambient decorative gradients -->
        <Ellipse Width="450" Height="450"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-120,-120,0,0" Opacity="0.45">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#EEF2FF" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Width="350" Height="350"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-100,-100" Opacity="0.35">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#E0F2FE" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Clean White Login Card -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="440"
                CornerRadius="20"
                Padding="40"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

            <StackPanel Spacing="22">
                <!-- Logo + Branding -->
                <StackPanel HorizontalAlignment="Center" Spacing="10" Margin="0,0,0,6">
                    <Border CornerRadius="16" Width="68" Height="68"
                            HorizontalAlignment="Center"
                            BorderThickness="1.5"
                            BorderBrush="#E0E7FF"
                            Background="#EEF2FF">
                        <Image Source="ms-appx:///Assets/AppLogo.png"
                               Width="56" Height="56"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Print Infinity Agent"
                               FontSize="22" FontWeight="Bold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Storekeeper · Shop PC Portal"
                               FontSize="12"
                               Foreground="#64748B"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Mode Title -->
                <TextBlock Text="{x:Bind ViewModel.TitleText, Mode=OneWay}"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="#1E293B" />

                <!-- Error / Success InfoBar -->
                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         Severity="Error"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <InfoBar IsOpen="{x:Bind ViewModel.HasSuccess, Mode=OneWay}"
                         Severity="Success"
                         Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}" />

                <!-- Form Fields -->
                <StackPanel Spacing="12">
                    <!-- Shop Name (Register Mode only) -->
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.RegisterFieldsVisibility, Mode=OneWay}">
                        <TextBlock Text="Shop / Store Name" FontSize="12" FontWeight="Medium" Foreground="#475569" />
                        <TextBox PlaceholderText="e.g. Apex Digital Print Hub"
                                 Text="{x:Bind ViewModel.StoreName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#F8FAFC"
                                 Foreground="#0F172A"
                                 BorderBrush="#CBD5E1"
                                 CornerRadius="10"
                                 Padding="12,10"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Email Address" FontSize="12" FontWeight="Medium" Foreground="#475569" />
                        <TextBox PlaceholderText="shopkeeper@store.com"
                                 Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#F8FAFC"
                                 Foreground="#0F172A"
                                 BorderBrush="#CBD5E1"
                                 CornerRadius="10"
                                 Padding="12,10"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Password" FontSize="12" FontWeight="Medium" Foreground="#475569" />
                        <PasswordBox x:Name="PasswordInput"
                                     PlaceholderText="Enter your password"
                                     PasswordChanged="PasswordInput_PasswordChanged"
                                     Background="#F8FAFC"
                                     Foreground="#0F172A"
                                     BorderBrush="#CBD5E1"
                                     CornerRadius="10"
                                     Padding="12,10"/>
                    </StackPanel>

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.RegisterFieldsVisibility, Mode=OneWay}">
                        <TextBlock Text="Confirm Password" FontSize="12" FontWeight="Medium" Foreground="#475569" />
                        <PasswordBox x:Name="ConfirmPasswordInput"
                                     PlaceholderText="Re-enter password"
                                     PasswordChanged="ConfirmPasswordInput_PasswordChanged"
                                     Background="#F8FAFC"
                                     Foreground="#0F172A"
                                     BorderBrush="#CBD5E1"
                                     CornerRadius="10"
                                     Padding="12,10"/>
                    </StackPanel>

                    <CheckBox Content="Remember me on this PC"
                              IsChecked="{x:Bind ViewModel.RememberMe, Mode=TwoWay}"
                              FontSize="13"
                              Foreground="#475569" />
                </StackPanel>

                <!-- Submit Button -->
                <Button HorizontalAlignment="Stretch"
                        Height="46"
                        CornerRadius="12"
                        Background="#4F46E5"
                        Command="{x:Bind ViewModel.SubmitCommand}"
                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                    <Grid>
                        <TextBlock Text="{x:Bind ViewModel.SubmitButtonText, Mode=OneWay}"
                                   FontWeight="Bold" FontSize="14" Foreground="White"
                                   Visibility="{x:Bind ViewModel.NotBusyVisibility, Mode=OneWay}"
                                   HorizontalAlignment="Center"/>
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}"
                                      Width="20" Height="20"
                                      HorizontalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- Mode Toggle -->
                <HyperlinkButton HorizontalAlignment="Center"
                                 Content="{x:Bind ViewModel.ModeToggleText, Mode=OneWay}"
                                 Command="{x:Bind ViewModel.ToggleModeCommand}"
                                 Foreground="#4F46E5" FontWeight="SemiBold" />

                <!-- Security Badge -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                    <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="#64748B" />
                    <TextBlock Text="Protected by Windows DPAPI &amp; Credential Locker"
                               FontSize="11" Foreground="#64748B" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
