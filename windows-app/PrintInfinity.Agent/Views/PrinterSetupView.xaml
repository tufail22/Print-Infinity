<UserControl
    x:Class="PrintInfinity.Agent.Views.PrinterSetupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PrintInfinity.Agent.Models"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Navigation Bar -->
        <Border Grid.Row="0" 
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                Padding="24,16" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="#EEF2FF" CornerRadius="8" Width="36" Height="36">
                        <FontIcon Glyph="&#xE749;" FontSize="18" Foreground="#4F46E5" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Print Infinity Agent" FontSize="18" FontWeight="Bold" />
                            <Border Background="#E0E7FF" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="{x:Bind ViewModel.StoreName, Mode=OneWay}" Foreground="#3730A3" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.StorekeeperEmail, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <!-- Action Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Heartbeat indicator -->
                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="#10B981" />
                            <TextBlock Text="Spooler Live Ping: 5s" FontSize="12" Foreground="#065F46" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Button Command="{x:Bind ViewModel.LoadPrintersCommand}" ToolTipService.ToolTip="Rescan Windows Printers">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Scan Printers" />
                        </StackPanel>
                    </Button>

                    <Button Style="{ThemeResource AccentButtonStyle}" 
                            Command="{x:Bind ViewModel.SaveAllCommand}" 
                            ToolTipService.ToolTip="Save all printer configurations to Supabase">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                            <TextBlock Text="Save All to Cloud" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.LogoutCommand}" ToolTipService.ToolTip="Sign out of storekeeper account">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xF3B1;" FontSize="14" />
                            <TextBlock Text="Sign Out" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" Padding="24">
            <StackPanel Spacing="16" MaxWidth="1050" HorizontalAlignment="Stretch">
                
                <!-- Status Notifications -->
                <InfoBar IsOpen="{x:Bind ViewModel.HasNotification, Mode=OneWay}"
                         Severity="Informational"
                         Message="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}" />

                <!-- Section Header -->
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Windows Installed Printers &amp; Cloud Mapping" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Tag each printer as Color or B&amp;W, assign connection type, and save directly to Supabase." 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" VerticalAlignment="Center" />
                </Grid>

                <!-- Printers List -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Printers, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:PrinterItem">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="20"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- Column 0: Printer Info & Queue Status -->
                                        <ColumnDefinition Width="320" />
                                        <!-- Column 1: Tags (Color & Connection) -->
                                        <ColumnDefinition Width="*" />
                                        <!-- Column 2: Save Action & Cloud Status -->
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Printer Info & Spooler Status -->
                                    <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center" Padding="0,0,16,0">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE749;" FontSize="22" Foreground="#4F46E5" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind WindowsPrinterName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="32,2,0,0">
                                            <TextBlock Text="Port:" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind PortName}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <!-- Live Queue Status Badge -->
                                        <Border Margin="32,4,0,0" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Background="#F1F5F9">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8" Height="8" Fill="{x:Bind StatusBadgeColor, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Tags & Configuration Controls -->
                                    <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center" Padding="12,0">
                                        <!-- Friendly Display Name -->
                                        <TextBox Header="Friendly Cloud Name" 
                                                 PlaceholderText="e.g. Counter 1 B&amp;W Laser" 
                                                 Text="{x:Bind DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Color / B&W Tag -->
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Print Type" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="16">
                                                    <RadioButton Content="B&amp;W (₹3)" IsChecked="{x:Bind IsBw, Mode=TwoWay}" GroupName="{x:Bind WindowsPrinterName}" />
                                                    <RadioButton Content="Color (₹10)" IsChecked="{x:Bind IsColor, Mode=TwoWay}" GroupName="{x:Bind WindowsPrinterName}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Connection Tag -->
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Connection" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="16">
                                                    <RadioButton Content="USB" IsChecked="{x:Bind IsUsb, Mode=TwoWay}" GroupName="{x:Bind PortName}" />
                                                    <RadioButton Content="WiFi / LAN" IsChecked="{x:Bind IsWifi, Mode=TwoWay}" GroupName="{x:Bind PortName}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Save Action & Cloud Feedback -->
                                    <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Button Style="{ThemeResource AccentButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Click="OnSaveSinglePrinterClick"
                                                DataContext="{x:Bind}">
                                            <Grid>
                                                <TextBlock Text="Save to Cloud" FontWeight="SemiBold" />
                                                <ProgressRing IsActive="{x:Bind IsSaving, Mode=OneWay}" Width="16" Height="16" />
                                            </Grid>
                                        </Button>

                                        <TextBlock Text="{x:Bind LastSavedAtText, Mode=OneWay}" 
                                                   FontSize="11" 
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                                   HorizontalAlignment="Center" 
                                                   TextAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" 
                Padding="16,10" 
                Background="{ThemeResource LayerFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="0,1,0,0">
            <TextBlock Text="Connected to Supabase Project ynfjuqqkrqgimttpgumx • Windows Print Subsystem Native Integration" 
                       FontSize="11" 
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                       HorizontalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
