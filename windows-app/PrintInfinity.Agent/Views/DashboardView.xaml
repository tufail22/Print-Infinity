<UserControl
    x:Class="PrintInfinity.Agent.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PrintInfinity.Agent.Models"
    xmlns:views="using:PrintInfinity.Agent.Views"
    mc:Ignorable="d">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0B0B14" Offset="0"/>
                <GradientStop Color="#111120" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== TOP HEADER NAV BAR ===== -->
        <Border Grid.Row="0" Padding="20,12"
                Background="#131322"
                BorderBrush="#1E2235"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo + Store Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            Spacing="12" VerticalAlignment="Center">
                    <Border CornerRadius="10" Width="42" Height="42"
                            BorderBrush="#6366F1" BorderThickness="1.5"
                            Background="#1A1A30">
                        <Image Source="ms-appx:///Assets/AppLogo.png"
                               Width="34" Height="34"
                               Stretch="Uniform"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Print Infinity Agent"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="White"/>
                            <Border CornerRadius="8" Padding="8,2"
                                    Background="#1E1A40">
                                <TextBlock Text="{x:Bind PrinterSetupVm.StoreName, Mode=OneWay}"
                                           Foreground="#A5B4FC"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind PrinterSetupVm.StorekeeperEmail, Mode=OneWay}"
                                   Foreground="#374151" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tab Navigation (simple ToggleButtons) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" Spacing="4"
                            VerticalAlignment="Center">

                    <ToggleButton x:Name="BtnTabQueue"
                                  Content="⚡  Live Print Queue"
                                  IsChecked="True"
                                  Click="OnTabQueueClick"
                                  Padding="16,8"
                                  CornerRadius="10"
                                  FontSize="13" FontWeight="SemiBold"
                                  Foreground="White"/>

                    <ToggleButton x:Name="BtnTabPrinters"
                                  Content="🖨  Hardware Printers"
                                  IsChecked="False"
                                  Click="OnTabPrintersClick"
                                  Padding="16,8"
                                  CornerRadius="10"
                                  FontSize="13" FontWeight="SemiBold"
                                  Foreground="#94A3B8"/>

                    <ToggleButton x:Name="BtnTabAudit"
                                  Content="📋  Audit Log"
                                  IsChecked="False"
                                  Click="OnTabAuditClick"
                                  Padding="16,8"
                                  CornerRadius="10"
                                  FontSize="13" FontWeight="SemiBold"
                                  Foreground="#94A3B8"/>
                </StackPanel>

                <!-- Right: Status + Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            Spacing="8" VerticalAlignment="Center">
                    <!-- Realtime Pulse -->
                    <Border CornerRadius="8" Padding="10,6"
                            Background="#05150E"
                            BorderBrush="#10B98140"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="7" Height="7" Fill="#10B981"/>
                            <TextBlock Text="Realtime Active"
                                       FontSize="11" Foreground="#10B981"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Minimize to Tray -->
                    <Button Click="OnMinimizeToTrayClick"
                            ToolTipService.ToolTip="Minimize to System Tray"
                            Background="#1E2235"
                            BorderBrush="#334155"
                            CornerRadius="8"
                            Padding="10,7">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE740;" FontSize="13" Foreground="#94A3B8"/>
                            <TextBlock Text="Tray" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Button>

                    <!-- Sign Out -->
                    <Button Click="OnSignOutClick"
                            ToolTipService.ToolTip="Sign out"
                            Background="#1A0E0E"
                            BorderBrush="#7F1D1D"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,7">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xF3B1;" FontSize="13" Foreground="#F87171"/>
                            <TextBlock Text="Sign Out" FontSize="12" Foreground="#F87171"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Row="1">

            <!-- TAB 1: LIVE PRINT QUEUE -->
            <ScrollViewer x:Name="QueueSection" Padding="28,24"
                          Visibility="Visible">
                <StackPanel Spacing="20" MaxWidth="980"
                            HorizontalAlignment="Stretch">

                    <InfoBar IsOpen="{x:Bind QueueVm.HasNotification, Mode=OneWay}"
                             Severity="Informational"
                             Message="{x:Bind QueueVm.NotificationMessage, Mode=OneWay}" />

                    <!-- Header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Live Incoming Print Queue"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="White"/>
                                <Border CornerRadius="14" Padding="12,3"
                                        VerticalAlignment="Center"
                                        Background="#6366F1">
                                    <TextBlock Text="{x:Bind QueueVm.JobCount, Mode=OneWay}"
                                               Foreground="White"
                                               FontSize="13" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Customer jobs awaiting storekeeper verification — privacy-first, print settings only."
                                       Foreground="#374151" FontSize="13"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind QueueVm.StatusMessage, Mode=OneWay}"
                                   Foreground="#374151" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Empty State -->
                    <Border Visibility="{x:Bind QueueVm.HasNoJobs, Mode=OneWay}"
                            CornerRadius="18" Padding="56"
                            Margin="0,16,0,0"
                            Background="#131322"
                            BorderBrush="#1E2235"
                            BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" Spacing="14">
                            <Border CornerRadius="36" Width="72" Height="72"
                                    HorizontalAlignment="Center"
                                    Background="#1E2235">
                                <FontIcon Glyph="&#xE749;" FontSize="30"
                                          Foreground="#374151"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Queue is Empty"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="#D1D5DB"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Customer print jobs will appear here in real-time."
                                       Foreground="#374151" FontSize="13"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Job Cards -->
                    <ItemsControl ItemsSource="{x:Bind QueueVm.PendingJobs, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:QueueItem">
                                <Border CornerRadius="16" Padding="24"
                                        Margin="0,0,0,14"
                                        BorderThickness="1"
                                        Background="#161627"
                                        BorderBrush="#1E2235">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="210"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Price & Color Mode -->
                                        <StackPanel Grid.Column="0" Spacing="8"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind FormattedPrice}"
                                                       FontSize="28" FontWeight="Bold"
                                                       Foreground="White"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border CornerRadius="6" Padding="8,3"
                                                        Background="{x:Bind ColorBadgeBackground}"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{x:Bind ColorModeBadgeText}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{x:Bind ColorBadgeForeground}"/>
                                                </Border>
                                                <Border CornerRadius="6" Padding="8,3"
                                                        Background="{x:Bind PaymentBadgeBackground, Mode=OneWay}"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{x:Bind PaymentBadgeText, Mode=OneWay}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{x:Bind PaymentBadgeForeground, Mode=OneWay}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind FormattedTime}"
                                                        FontSize="11" Foreground="#374151"/>
                                        </StackPanel>

                                        <!-- Print Specs -->
                                        <StackPanel Grid.Column="1" Spacing="10"
                                                    VerticalAlignment="Center"
                                                    Padding="20,0">
                                            <StackPanel Orientation="Horizontal" Spacing="28">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="PAGES" FontSize="10"
                                                               Foreground="#374151"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{x:Bind FormattedPages}"
                                                               FontSize="16" FontWeight="Bold"
                                                               Foreground="#E2E8F0"/>
                                                </StackPanel>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="COPIES" FontSize="10"
                                                               Foreground="#374151"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{x:Bind FormattedCopies}"
                                                               FontSize="16" FontWeight="Bold"
                                                               Foreground="#E2E8F0"/>
                                                </StackPanel>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="PAPER" FontSize="10"
                                                               Foreground="#374151"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{x:Bind PaperSize}"
                                                               FontSize="16" FontWeight="Bold"
                                                               Foreground="#E2E8F0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72E;" FontSize="11"
                                                          Foreground="#10B981"/>
                                                <TextBlock Text="Privacy Guard: content preview omitted"
                                                           FontSize="11" Foreground="#065F46"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="2" Spacing="10"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <Button HorizontalAlignment="Stretch"
                                                    Height="42" CornerRadius="10"
                                                    Background="#059669"
                                                    IsTabStop="True"
                                                    AccessKey="A"
                                                    AutomationProperties.Name="Approve and print job"
                                                    Click="OnApproveJobClick"
                                                    DataContext="{x:Bind}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="14"
                                                              Foreground="White"/>
                                                    <TextBlock Text="{x:Bind ApproveButtonText, Mode=OneWay}"
                                                               FontWeight="Bold" FontSize="13"
                                                               Foreground="White"/>
                                                    <ProgressRing IsActive="{x:Bind IsApproving, Mode=OneWay}"
                                                                  Width="14" Height="14"
                                                                  Foreground="White"
                                                                  Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Button>

                                            <Button HorizontalAlignment="Stretch"
                                                    Height="38" CornerRadius="10"
                                                    Background="#1A0E0E"
                                                    BorderBrush="#7F1D1D"
                                                    BorderThickness="1"
                                                    IsTabStop="True"
                                                    AccessKey="R"
                                                    AutomationProperties.Name="Reject print job"
                                                    Click="OnRejectJobClick"
                                                    DataContext="{x:Bind}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE711;" FontSize="13"
                                                              Foreground="#F87171"/>
                                                    <TextBlock Text="Reject..."
                                                               FontSize="13"
                                                               Foreground="#F87171"/>
                                                    <ProgressRing IsActive="{x:Bind IsRejecting, Mode=OneWay}"
                                                                  Width="14" Height="14"
                                                                  Foreground="#F87171"
                                                                  Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 2: PRINTER SETUP -->
            <ScrollViewer x:Name="PrintersSection" Padding="28,24"
                          Visibility="Collapsed">
                <views:PrinterSetupView x:Name="PrinterSetupControl" ViewModel="{x:Bind PrinterSetupVm, Mode=OneWay}"/>
            </ScrollViewer>

            <!-- TAB 3: AUDIT LOG -->
            <ScrollViewer x:Name="AuditSection" Padding="28,24"
                          Visibility="Collapsed">
                <StackPanel Spacing="16" MaxWidth="980"
                            HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="Storekeeper Operational Audit Log"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Text-only records of processed print jobs. No file storage."
                                   Foreground="#374151" FontSize="13"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind QueueVm.AuditLogs, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AuditLogEntry">
                                <Border CornerRadius="10" Padding="16,12"
                                        Margin="0,0,0,8"
                                        Background="#131322"
                                        BorderBrush="#1E2235"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{x:Bind FormattedTimestamp}"
                                                   FontSize="12" Foreground="#374151"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" CornerRadius="4"
                                                Padding="8,3" HorizontalAlignment="Left"
                                                Background="#1E2235">
                                            <TextBlock Text="{x:Bind Status}"
                                                       FontWeight="Bold" FontSize="12"
                                                       Foreground="{x:Bind StatusBadgeColor}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind FormattedPages}"
                                                   FontSize="12" Foreground="#4B5563"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{x:Bind Details}"
                                                   FontSize="12" Foreground="#374151"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== FOOTER STATUS BAR ===== -->
        <Border Grid.Row="2" Padding="20,8"
                Background="#0B0B14"
                BorderBrush="#1E2235"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="#10B981"/>
                        <TextBlock Text="Zero-Disk Privacy: Files stream to memory only"
                                   FontSize="11" Foreground="#1F2937"/>
                    </StackPanel>
                    <TextBlock Text="•" FontSize="11" Foreground="#1F2937"/>
                    <TextBlock Text="Always-On Background Listener Active"
                               FontSize="11" Foreground="#1F2937"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="Print Infinity Agent v1.0"
                           FontSize="11" Foreground="#1F2937"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
