<UserControl
    x:Class="PrintInfinity.Agent.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PrintInfinity.Agent.Models"
    xmlns:views="using:PrintInfinity.Agent.Views"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== TOP HEADER NAV BAR ===== -->
        <!-- ===== TOP HEADER NAV BAR ===== -->
        <Border Grid.Row="0" Padding="20,10"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo + Store Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            Spacing="10" VerticalAlignment="Center">
                    <Border CornerRadius="10" Width="38" Height="38"
                            BorderBrush="#E0E7FF" BorderThickness="1"
                            Background="#EEF2FF">
                        <Image Source="ms-appx:///Assets/AppLogo.png"
                               Width="30" Height="30"
                               Stretch="Uniform"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Print Infinity Agent"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="#0F172A"/>
                            <Border CornerRadius="6" Padding="6,2"
                                    Background="#EEF2FF"
                                    BorderBrush="#E0E7FF"
                                    BorderThickness="1">
                                <TextBlock Text="{x:Bind PrinterSetupVm.StoreName, Mode=OneWay}"
                                           Foreground="#4338CA"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind PrinterSetupVm.StorekeeperEmail, Mode=OneWay}"
                                   Foreground="#64748B" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Modern Segmented Pill Tab Navigation -->
                <Border Grid.Column="1" HorizontalAlignment="Center"
                        Background="#F1F5F9" CornerRadius="12" Padding="4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <!-- Tab 1: Queue -->
                        <Button x:Name="BtnTabQueue"
                                Click="OnTabQueueClick"
                                Background="#FFFFFF"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,6">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE749;" FontSize="13" Foreground="#4338CA"/>
                                <TextBlock Text="Live Print Queue"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#4338CA"/>
                                <Border Visibility="{x:Bind QueueVm.HasJobs, Mode=OneWay}"
                                        CornerRadius="8" Padding="6,1"
                                        Background="#4F46E5" Margin="2,0,0,0">
                                    <TextBlock Text="{x:Bind QueueVm.JobCount, Mode=OneWay}"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Tab 2: Hardware Printers -->
                        <Button x:Name="BtnTabPrinters"
                                Click="OnTabPrintersClick"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="14,6">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEBD2;" FontSize="13" Foreground="#64748B"/>
                                <TextBlock Text="Hardware Printers"
                                           FontSize="12" FontWeight="Medium"
                                           Foreground="#64748B"/>
                            </StackPanel>
                        </Button>

                        <!-- Tab 3: Audit Log -->
                        <Button x:Name="BtnTabAudit"
                                Click="OnTabAuditClick"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="14,6">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE9D9;" FontSize="13" Foreground="#64748B"/>
                                <TextBlock Text="Audit Log"
                                           FontSize="12" FontWeight="Medium"
                                           Foreground="#64748B"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Right: Status + Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            Spacing="8" VerticalAlignment="Center">
                    <!-- Realtime Pulse -->
                    <Border CornerRadius="8" Padding="10,5"
                            Background="#ECFDF5"
                            BorderBrush="#A7F3D0"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="7" Height="7" Fill="#10B981"/>
                            <TextBlock Text="Realtime Active"
                                       FontSize="11" Foreground="#047857"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Minimize to Tray -->
                    <Button Click="OnMinimizeToTrayClick"
                            ToolTipService.ToolTip="Minimize to System Tray"
                            Background="#FFFFFF"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE740;" FontSize="13" Foreground="#475569"/>
                            <TextBlock Text="Tray" FontSize="12" Foreground="#475569"/>
                        </StackPanel>
                    </Button>

                    <!-- Sign Out -->
                    <Button Click="OnSignOutClick"
                            ToolTipService.ToolTip="Sign out"
                            Background="#FEF2F2"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xF3B1;" FontSize="13" Foreground="#DC2626"/>
                            <TextBlock Text="Sign Out" FontSize="12" Foreground="#DC2626" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Row="1">

            <!-- TAB 1: LIVE PRINT QUEUE -->
            <ScrollViewer x:Name="QueueSection" Padding="28,20"
                          Visibility="Visible">
                <StackPanel Spacing="16" MaxWidth="980"
                            HorizontalAlignment="Stretch">

                    <InfoBar IsOpen="{x:Bind QueueVm.HasNotification, Mode=OneWay}"
                             Severity="{x:Bind QueueVm.NotificationSeverity, Mode=OneWay}"
                             Message="{x:Bind QueueVm.NotificationMessage, Mode=OneWay}"
                             CornerRadius="10" />

                    <!-- Header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Live Incoming Print Queue"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="#0F172A"/>
                                <Border CornerRadius="14" Padding="12,3"
                                        VerticalAlignment="Center"
                                        Background="#4F46E5">
                                    <TextBlock Text="{x:Bind QueueVm.JobCount, Mode=OneWay}"
                                               Foreground="White"
                                               FontSize="13" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Customer jobs awaiting storekeeper verification — privacy-first, print settings only."
                                       Foreground="#64748B" FontSize="13"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind QueueVm.StatusMessage, Mode=OneWay}"
                                   Foreground="#64748B" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Empty State -->
                    <Border Visibility="{x:Bind QueueVm.HasNoJobs, Mode=OneWay}"
                            CornerRadius="18" Padding="56"
                            Margin="0,16,0,0"
                            Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" Spacing="14">
                            <Border CornerRadius="36" Width="72" Height="72"
                                    HorizontalAlignment="Center"
                                    Background="#EEF2FF">
                                <FontIcon Glyph="&#xE749;" FontSize="30"
                                          Foreground="#6366F1"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Queue is Empty"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="#1E293B"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Customer print jobs will appear here in real-time."
                                       Foreground="#64748B" FontSize="13"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Job Cards -->
                    <!-- Job Cards: FIX 12 - ListView virtualizes items; only renders visible cards -->
                    <ListView ItemsSource="{x:Bind QueueVm.PendingJobs, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:QueueItem">
                                <Border CornerRadius="16" Padding="24"
                                        Margin="0,0,0,14"
                                        BorderThickness="1"
                                        Background="#FFFFFF"
                                        BorderBrush="#E2E8F0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="210"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Price & Color Mode -->
                                        <StackPanel Grid.Column="0" Spacing="8"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind FormattedPrice}"
                                                       FontSize="28" FontWeight="Bold"
                                                       Foreground="#0F172A"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border CornerRadius="6" Padding="8,3"
                                                        Background="{x:Bind ColorBadgeBackground}"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{x:Bind ColorModeBadgeText}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{x:Bind ColorBadgeForeground}"/>
                                                </Border>
                                                <Border CornerRadius="6" Padding="8,3"
                                                        Background="{x:Bind PaymentBadgeBackground, Mode=OneWay}"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{x:Bind PaymentBadgeText, Mode=OneWay}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{x:Bind PaymentBadgeForeground, Mode=OneWay}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind FormattedTime}"
                                                       FontSize="11" Foreground="#94A3B8"/>
                                        </StackPanel>

                                        <!-- Print Specs -->
                                        <StackPanel Grid.Column="1" Spacing="10"
                                                    VerticalAlignment="Center"
                                                    Padding="16,0">
                                            <StackPanel Orientation="Horizontal" Spacing="22">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="PAGES" FontSize="10"
                                                               Foreground="#64748B"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{x:Bind FormattedPages}"
                                                               FontSize="15" FontWeight="Bold"
                                                               Foreground="#0F172A"/>
                                                </StackPanel>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="COPIES" FontSize="10"
                                                               Foreground="#64748B"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{x:Bind FormattedCopies}"
                                                               FontSize="15" FontWeight="Bold"
                                                               Foreground="#0F172A"/>
                                                </StackPanel>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="PAPER" FontSize="10"
                                                               Foreground="#64748B"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{x:Bind PaperSize}"
                                                               FontSize="15" FontWeight="Bold"
                                                               Foreground="#0F172A"/>
                                                </StackPanel>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="SIDES" FontSize="10"
                                                               Foreground="#64748B"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{x:Bind FormattedDuplex, Mode=OneWay}"
                                                               FontSize="15" FontWeight="Bold"
                                                               Foreground="#0F172A"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72E;" FontSize="11"
                                                          Foreground="#059669"/>
                                                <TextBlock Text="Privacy Guard: content preview omitted (zero-disk streaming)"
                                                           FontSize="11" Foreground="#059669"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="2" Spacing="10"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <Button HorizontalAlignment="Stretch"
                                                    Height="42" CornerRadius="10"
                                                    Background="#10B981"
                                                    IsTabStop="True"
                                                    AccessKey="A"
                                                    AutomationProperties.Name="Approve and print job"
                                                    Click="OnApproveJobClick"
                                                    DataContext="{x:Bind}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="14"
                                                              Foreground="White"/>
                                                    <TextBlock Text="{x:Bind ApproveButtonText, Mode=OneWay}"
                                                               FontWeight="Bold" FontSize="13"
                                                               Foreground="White"/>
                                                    <ProgressRing IsActive="{x:Bind IsApproving, Mode=OneWay}"
                                                                  Width="14" Height="14"
                                                                  Foreground="White"
                                                                  Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Button>

                                            <Button HorizontalAlignment="Stretch"
                                                    Height="38" CornerRadius="10"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#FECACA"
                                                    BorderThickness="1"
                                                    IsTabStop="True"
                                                    AccessKey="R"
                                                    AutomationProperties.Name="Reject print job"
                                                    Click="OnRejectJobClick"
                                                    DataContext="{x:Bind}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE711;" FontSize="13"
                                                              Foreground="#EF4444"/>
                                                    <TextBlock Text="Reject..."
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#EF4444"/>
                                                    <ProgressRing IsActive="{x:Bind IsRejecting, Mode=OneWay}"
                                                                  Width="14" Height="14"
                                                                  Foreground="#EF4444"
                                                                  Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 2: PRINTER SETUP -->
            <ScrollViewer x:Name="PrintersSection" Padding="28,24"
                          Visibility="Collapsed">
                <views:PrinterSetupView x:Name="PrinterSetupControl" ViewModel="{x:Bind PrinterSetupVm, Mode=OneWay}"/>
            </ScrollViewer>

            <!-- TAB 3: AUDIT LOG -->
            <ScrollViewer x:Name="AuditSection" Padding="28,24"
                          Visibility="Collapsed">
                <StackPanel Spacing="16" MaxWidth="980"
                            HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="Storekeeper Operational Audit Log"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="Text-only records of processed print jobs. Zero disk persistence."
                                   Foreground="#64748B" FontSize="13"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Table Column Header -->
                    <Border CornerRadius="8" Padding="16,10"
                            Background="#F1F5F9"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TIMESTAMP" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Grid.Column="2" Text="PAGES &amp; COPIES" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Grid.Column="3" Text="DETAILS &amp; NOTES" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        </Grid>
                    </Border>

                    <!-- Empty Audit State -->
                    <Border Visibility="{x:Bind QueueVm.HasNoAuditLogs, Mode=OneWay}"
                            CornerRadius="14" Padding="36"
                            Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="24" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock Text="No audit records yet" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock Text="Approved, completed, and rejected print jobs will appear here." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Audit Log: FIX 12 - ListView virtualizes items -->
                    <ListView ItemsSource="{x:Bind QueueVm.AuditLogs, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:AuditLogEntry">
                                <Border CornerRadius="10" Padding="16,12"
                                        Margin="0,0,0,8"
                                        Background="#FFFFFF"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{x:Bind FormattedTimestamp}"
                                                   FontSize="12" Foreground="#64748B"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" CornerRadius="4"
                                                Padding="8,3" HorizontalAlignment="Left"
                                                Background="#EEF2FF">
                                            <TextBlock Text="{x:Bind Status}"
                                                       FontWeight="Bold" FontSize="12"
                                                       Foreground="{x:Bind StatusBadgeColor}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind FormattedPages}"
                                                   FontSize="12" Foreground="#334155"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{x:Bind Details}"
                                                   FontSize="12" Foreground="#64748B"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== FOOTER STATUS BAR ===== -->
        <Border Grid.Row="2" Padding="20,8"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="#10B981"/>
                        <TextBlock Text="Zero-Disk Privacy: In-Memory Stream Only"
                                   FontSize="11" Foreground="#64748B" FontWeight="Medium"/>
                    </StackPanel>
                    <TextBlock Text="•" FontSize="11" Foreground="#CBD5E1"/>
                    <TextBlock Text="Always-On Realtime Listener Active"
                               FontSize="11" Foreground="#64748B"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="Print Infinity Agent v2.0"
                           FontSize="11" Foreground="#94A3B8"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
