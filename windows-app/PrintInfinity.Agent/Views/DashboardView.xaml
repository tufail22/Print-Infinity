<UserControl
    x:Class="PrintInfinity.Agent.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PrintInfinity.Agent.Models"
    xmlns:views="using:PrintInfinity.Agent.Views"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Navigation Bar -->
        <Border Grid.Row="0" 
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                Padding="24,14" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="#EEF2FF" CornerRadius="10" Width="40" Height="40">
                        <FontIcon Glyph="&#xE749;" FontSize="20" Foreground="#4F46E5" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Print Infinity Agent" FontSize="18" FontWeight="Bold" />
                            <Border Background="#E0E7FF" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="{x:Bind PrinterSetupVm.StoreName, Mode=OneWay}" Foreground="#3730A3" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind PrinterSetupVm.StorekeeperEmail, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <!-- Centered Navigation Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <RadioButtons x:Name="ViewSelector" SelectedIndex="0" SelectionChanged="OnViewSelectionChanged">
                        <RadioButtons.Items>
                            <RadioButton Content="Live Print Queue" Tag="Queue" IsChecked="True" />
                            <RadioButton Content="Hardware Printers" Tag="Printers" />
                            <RadioButton Content="Audit Log" Tag="Audit" />
                        </RadioButtons.Items>
                    </RadioButtons>
                </StackPanel>

                <!-- Top Right Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Realtime Pulse -->
                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="#10B981" />
                            <TextBlock Text="Realtime Active" FontSize="12" Foreground="#065F46" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- Minimize to Tray Button -->
                    <Button Click="OnMinimizeToTrayClick" ToolTipService.ToolTip="Hide to Windows System Tray (keeps listening)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE740;" FontSize="14" />
                            <TextBlock Text="Tray" />
                        </StackPanel>
                    </Button>

                    <!-- Sign Out Button -->
                    <Button Click="OnSignOutClick" ToolTipService.ToolTip="Sign out of storekeeper account">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xF3B1;" FontSize="14" />
                            <TextBlock Text="Sign Out" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tab Content Container -->
        <Grid Grid.Row="1">
            <!-- TAB 1: LIVE PRINT QUEUE -->
            <ScrollViewer x:Name="QueueSection" Padding="24" Visibility="Visible">
                <StackPanel Spacing="16" MaxWidth="960" HorizontalAlignment="Stretch">
                    
                    <!-- Notification Banner -->
                    <InfoBar IsOpen="{x:Bind QueueVm.HasNotification, Mode=OneWay}"
                             Severity="Informational"
                             Message="{x:Bind QueueVm.NotificationMessage, Mode=OneWay}" />

                    <!-- Section Header -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Live Incoming Print Queue" FontSize="20" FontWeight="Bold" />
                                <Border Background="#4F46E5" CornerRadius="12" Padding="10,2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind QueueVm.JobCount, Mode=OneWay}" Foreground="White" FontSize="12" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Customer jobs awaiting shopkeeper verification. Zero-disk &amp; privacy-first: strictly print settings only." 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind QueueVm.StatusMessage, Mode=OneWay}" 
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Empty State -->
                    <Border Visibility="{x:Bind QueueVm.HasNoJobs, Mode=OneWay}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="48"
                            Margin="0,20,0,0">
                        <StackPanel HorizontalAlignment="Center" Spacing="12">
                            <Border Background="#F1F5F9" CornerRadius="32" Width="64" Height="64" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE749;" FontSize="28" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Queue is Empty" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Incoming print jobs from store customers will appear here in real-time." 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Job Cards List -->
                    <ItemsControl ItemsSource="{x:Bind QueueVm.PendingJobs, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:QueueItem">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="22"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Column 0: Price & Color Badge -->
                                            <ColumnDefinition Width="220" />
                                            <!-- Column 1: Print Specs (NO filename, NO thumbnail) -->
                                            <ColumnDefinition Width="*" />
                                            <!-- Column 2: Two Action Buttons (Approve, Reject) -->
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Price & Color Mode -->
                                        <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind FormattedPrice}" FontSize="26" FontWeight="Bold" Foreground="#0F172A" />
                                            <Border Background="{x:Bind ColorBadgeBackground}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{x:Bind ColorModeBadgeText}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind ColorBadgeForeground}" />
                                            </Border>
                                            <TextBlock Text="{x:Bind FormattedTime}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>

                                        <!-- Technical Print Parameters ONLY (Privacy Guaranteed) -->
                                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" Padding="16,0">
                                            <StackPanel Orientation="Horizontal" Spacing="24">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Pages" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{x:Bind FormattedPages}" FontSize="15" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Copies" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{x:Bind FormattedCopies}" FontSize="15" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Paper Size" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{x:Bind PaperSize}" FontSize="15" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Privacy Commitment Tag -->
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                                <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="#10B981" />
                                                <TextBlock Text="Privacy Guard: Content preview omitted" FontSize="11" Foreground="#059669" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Two Action Buttons: Approve & Reject -->
                                        <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <!-- Approve Button -->
                                            <Button Style="{ThemeResource AccentButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    Height="38"
                                                    Click="OnApproveJobClick"
                                                    DataContext="{x:Bind}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="13" />
                                                    <TextBlock Text="Approve" FontWeight="SemiBold" />
                                                    <ProgressRing IsActive="{x:Bind IsApproving, Mode=OneWay}" Width="14" Height="14" Margin="4,0,0,0" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Reject Button (Requires reason) -->
                                            <Button HorizontalAlignment="Stretch"
                                                    Height="36"
                                                    Foreground="#DC2626"
                                                    Click="OnRejectJobClick"
                                                    DataContext="{x:Bind}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE711;" FontSize="13" />
                                                    <TextBlock Text="Reject..." />
                                                    <ProgressRing IsActive="{x:Bind IsRejecting, Mode=OneWay}" Width="14" Height="14" Margin="4,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 2: PRINTER SETUP -->
            <ScrollViewer x:Name="PrintersSection" Padding="24" Visibility="Collapsed">
                <views:PrinterSetupView x:Name="PrinterSetupControl" />
            </ScrollViewer>

            <!-- TAB 3: AUDIT LOG (Text-only, no thumbnails) -->
            <ScrollViewer x:Name="AuditSection" Padding="24" Visibility="Collapsed">
                <StackPanel Spacing="16" MaxWidth="960" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="Storekeeper Operational Audit Log" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="Strictly text-only records of processed print jobs. Zero file storage or content previews." 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" Margin="0,2,0,0" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind QueueVm.AuditLogs, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AuditLogEntry">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{x:Bind FormattedTimestamp}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{x:Bind Status}" FontWeight="Bold" FontSize="12" Foreground="{x:Bind StatusBadgeColor}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{x:Bind FormattedPages}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Details}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" 
                Padding="16,8" 
                Background="{ThemeResource LayerFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                <TextBlock Text="🔒 Zero-Disk Privacy: Document contents stream to memory only and are never saved to disk" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Always-On Background Listener Active" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
