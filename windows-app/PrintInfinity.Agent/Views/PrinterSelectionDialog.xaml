<ContentDialog
    x:Class="PrintInfinity.Agent.Views.PrinterSelectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PrintInfinity.Agent.Models"
    mc:Ignorable="d"
    Title="Select Target Printer"
    PrimaryButtonText="Print to Selected"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <StackPanel Spacing="16" Width="440">
        <TextBlock Text="Multiple online printers match this job's color mode. Select which printer should process the document:" 
                   TextWrapping="Wrap" 
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                   FontSize="13" />

        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                MaxHeight="260">
            <ListView x:Name="PrintersList" 
                      SelectionMode="Single" 
                      SelectionChanged="OnSelectionChanged"
                      Padding="4">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PrinterItem">
                        <Grid Padding="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Background="#EEF2FF" CornerRadius="6" Width="32" Height="32" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE749;" FontSize="16" Foreground="#4F46E5" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{x:Bind WindowsPrinterName}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>

                            <Border Grid.Column="2" Background="#ECFDF5" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="Online" FontSize="11" FontWeight="SemiBold" Foreground="#059669" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </StackPanel>
</ContentDialog>
