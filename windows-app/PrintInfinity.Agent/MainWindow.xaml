<Window
    x:Class="PrintInfinity.Agent.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PrintInfinity.Agent"
    xmlns:models="using:PrintInfinity.Agent.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Print Infinity Agent — Storekeeper Dashboard">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header / Status Bar -->
        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="24,16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Print Infinity Agent" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="#E0E7FF" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Text="Store #1 — Online" Foreground="#4338CA" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Printer Settings" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content: Job Queue -->
        <ScrollViewer Grid.Row="1" Padding="24">
            <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Stretch">
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Live Print Queue" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>

                <!-- Queue List -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.PendingJobs, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:PrintJob">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="12" 
                                    Padding="20" 
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Job Specs -->
                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind FileName}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Border Background="#F1F5F9" CornerRadius="6" Padding="6,2">
                                                <TextBlock Text="{x:Bind FormattedAmount}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <TextBlock Text="{x:Bind TotalPages, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                                            <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind PaymentBadgeText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#4338CA" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Two-Step Storekeeper Actions -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <!-- Step 1: Cash Confirmation (Enabled only for pending cash payments) -->
                                        <Button Content="💵 Confirm Cash" 
                                                IsEnabled="{x:Bind CanConfirmCash, Mode=OneWay}"
                                                Click="OnConfirmCashClick"
                                                ToolTipService.ToolTip="Acknowledge cash payment from customer" />

                                        <!-- Step 2: Job Approval (Enabled ONLY when payment is verified) -->
                                        <Button Content="🖨️ Approve &amp; Print" 
                                                Style="{ThemeResource AccentButtonStyle}"
                                                IsEnabled="{x:Bind CanApprove, Mode=OneWay}"
                                                Click="OnApproveClick"
                                                ToolTipService.ToolTip="Approve job to stream into printer memory" />

                                        <!-- Reject Action -->
                                        <Button Content="Reject" 
                                                Click="OnRejectClick"
                                                Foreground="#DC2626" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer / Privacy Commitment -->
        <Border Grid.Row="2" Padding="16,12" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="🔒 Zero-Disk Persistence: All documents stream directly into printer memory and are purged immediately." FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
        </Border>
    </Grid>
</Window>
